# Supabase (required)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard password
ADMIN_PASSWORD=your-admin-password

# Supabase PAT (for setup scripts only)
SUPABASE_PAT=your-supabase-personal-access-token

# PayPal (sandbox for testing, live for production)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# SMTP (booking notification emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@qumraacademy.com
SMTP_PASS=your-email-password
NOTIFY_TO=info@qumraacademy.com
